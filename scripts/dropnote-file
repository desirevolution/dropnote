#!/bin/sh
set -eu
. "${0%/*}/dropnote-common.sh"

usage() {
    printf '%s\n' 'Usage: dropnote-file [-s SPACE] [-n DISPLAY_NAME] [-f FILENAME] [-t MIME_TYPE] FILE|-' \
        'Upload one file. Use -f to name input from stdin. SPACE defaults to default.'
}

space=default
display_name=
filename=
mime_type=
while getopts ':s:n:f:t:h' option; do
    case $option in
        s) space=$OPTARG ;;
        n) display_name=$OPTARG ;;
        f) filename=$OPTARG ;;
        t) mime_type=$OPTARG ;;
        h) usage; exit 0 ;;
        :) fail "Option -$OPTARG needs a value." ;;
        \?) fail "Unknown option -$OPTARG. See -h." ;;
    esac
done
shift "$((OPTIND - 1))"
[ "$#" -eq 1 ] || fail 'Provide one file or use - for stdin. See -h.'

source=$1
if [ "$source" = "-" ]; then
    [ ! -t 0 ] || fail 'Pipe in a file or pass a file path. See -h.'
    [ -n "$filename" ] || fail 'Use -f to set the filename for stdin.'
else
    [ -f "$source" ] && [ -r "$source" ] || fail "Cannot read file: $source"
    filename=${filename:-${source##*/}}
    if [ -z "$mime_type" ] && command -v file >/dev/null 2>&1; then
        mime_type=$(file -b --mime-type - < "$source" 2>/dev/null) || mime_type=
    fi
fi
case $filename in
    */*|*\\*) fail 'Use a filename without a directory.' ;;
esac
validate_header 'Filename' "$filename"
validate_header 'MIME type' "$mime_type"

send_to_dropnote files 201 -H "X-Filename: $filename" \
    -H "Content-Type: ${mime_type:-application/octet-stream}" --data-binary "@$source"
