# Dropnote configuration. Unset variables use their defaults.
# Copy to .env (or set the variables in your process manager / container runtime).
# Under Compose this same file is interpolated and forwarded into the container.

# Compose only: the port people reach the site on from the HOST
# (compose.yaml publishes it; the app itself listens on PORT, see below).
#SHARE_TOOL_PORT=8080

# HTTP port the server listens on ("0" picks a free port for local development).
# Compose maps SHARE_TOOL_PORT to this port. The image defaults to 3000.
#PORT=3000

# Public base URL, including the scheme. In multiuser mode it also
# defines the accepted browser origin for writes and WebSockets.
#BASE_URL=http://localhost:3000

# Directory holding all persistent state (JSON index, per-Pad data).
#DATA_DIR=./data

# Multiuser mode requires a trusted authentication proxy that sets X-Forwarded-User.
# Use a separate data directory or volume when switching modes.
#MULTIUSER=false

# Comma-separated IPs or CIDRs of direct proxy connections. Required in multiuser mode.
#TRUSTED_PROXIES=172.30.50.2,fd00:50::2

# Instance PIN gating Pad creation. Unset (default) means creation is open;
# reading and editing existing Pads never require this PIN.
#INSTANCE_PIN=

# Default TTL offered at Pad creation: s/m/h/d, a plain number of seconds, or "never".
#DEFAULT_TTL=7d

# Longest TTL a Pad may be given: s/m/h/d, a plain number of seconds, or
# "never" (default, unbounded). Must not be shorter than DEFAULT_TTL; when
# set, "never" is no longer offered at creation.
#MAX_TTL=never

# Per-file size limit: plain bytes or KB/MB/GB (1024-based).
#MAX_FILE_SIZE=1GB

# Total stored attachment bytes across the instance.
#MAX_INSTANCE_SIZE=10GB

# URL path prefix under which additional Pads are addressed.
#PAD_PATH=/p

# How long a client IP stays locked out of a Pad after 5 failed PIN attempts.
#PIN_LOCKOUT_SECONDS=15m

# How often the cleanup sweep deletes expired Pads (with all their files).
#CLEANUP_SWEEP_SECONDS=60s

# Rate limiting is always on.
#RATE_LIMIT_WINDOW=1m
#RATE_LIMIT_MAX=120
